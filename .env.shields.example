# Shields Farms environment example
# Do not include real secrets in this file.
# Use Shields Farms Supabase and notification credentials, not Noble Farms credentials.

# Brand / public site configuration
NEXT_PUBLIC_SITE_NAME="Shields Farms"
NEXT_PUBLIC_SITE_URL="https://YOUR-VERCEL-SHIELDS-DOMAIN.vercel.app"
NEXT_PUBLIC_SITE_DOMAIN="YOUR-VERCEL-SHIELDS-DOMAIN.vercel.app"
NEXT_PUBLIC_SITE_TAGLINE="Fresh produce supplied with care."
NEXT_PUBLIC_SITE_DESCRIPTION="Order fresh poultry, eggs, crop produce, and selected farm inputs directly from Shields Farms."
NEXT_PUBLIC_BUSINESS_ADDRESS="Alapata, Olodo, Ibadan, Nigeria"
NEXT_PUBLIC_BUSINESS_PHONE="+2347034400380"
NEXT_PUBLIC_BUSINESS_EMAIL="info@YOUR-SHIELDS-DOMAIN"
NEXT_PUBLIC_SUPPORT_EMAIL="support@YOUR-SHIELDS-DOMAIN"
NEXT_PUBLIC_ORDERS_EMAIL="orders@YOUR-SHIELDS-DOMAIN"
NEXT_PUBLIC_WHATSAPP_PHONE="+2347034400380"
NEXT_PUBLIC_LOGO_PATH="/images/shields-farms-logo.png"

# Supabase - use the separate Shields Farms project keys
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
ADMIN_EMAIL="heeshat@gmail.com"

# Paystack
# Use the same Paystack keys as Noble Farms only if the same Paystack business
# account should receive Shields Farms payments. Keep these empty until chosen.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Notifications
NOTIFICATIONS_ENABLED=true
ADMIN_NOTIFICATION_EMAIL="heeshat@gmail.com"
ADMIN_NOTIFICATION_WHATSAPP_TO="2347034400380"

# Email notifications: set EMAIL_PROVIDER to gmail or resend.
EMAIL_PROVIDER=gmail
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
FROM_EMAIL="Shields Farms <notifications@YOUR-SHIELDS-DOMAIN>"
REPLY_TO_EMAIL="support@YOUR-SHIELDS-DOMAIN"

# Optional Resend email provider
RESEND_API_KEY=""

# Choose one WhatsApp provider: cloud, webhook, or callmebot.
WHATSAPP_PROVIDER=cloud

# WhatsApp Cloud provider
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_TEMPLATE_NAME=""
WHATSAPP_CUSTOMER_STATUS_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE=en

# WhatsApp webhook provider
# To use this provider, set WHATSAPP_PROVIDER=webhook.
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_SECRET=""

# CallMeBot testing provider
# To use this provider, set WHATSAPP_PROVIDER=callmebot.
# CallMeBot is suitable for low-volume internal testing/personal-use notifications only.
# For production WhatsApp Business messaging, use WhatsApp Cloud API.
CALLMEBOT_API_KEY=""