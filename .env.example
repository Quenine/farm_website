# This file contains Noble Farms example values. Each deployment must set its own production environment variables.
NEXT_PUBLIC_SITE_NAME="Noble Farms"
NEXT_PUBLIC_SITE_URL="https://noblefarms.xyz"
NEXT_PUBLIC_SITE_DOMAIN="noblefarms.xyz"
NEXT_PUBLIC_SITE_TAGLINE="Fresh poultry, eggs, and farm produce supplied with care."
NEXT_PUBLIC_SITE_DESCRIPTION="Order fresh poultry, eggs, crop produce, and selected farm inputs directly from Noble Farms."
NEXT_PUBLIC_BUSINESS_ADDRESS="Noble Farms, Alapata, Ibadan, Nigeria"
NEXT_PUBLIC_BUSINESS_PHONE="+2349035712314"
NEXT_PUBLIC_BUSINESS_EMAIL="info@noblefarms.xyz"
NEXT_PUBLIC_SUPPORT_EMAIL="support@noblefarms.xyz"
NEXT_PUBLIC_ORDERS_EMAIL="orders@noblefarms.xyz"
NEXT_PUBLIC_WHATSAPP_PHONE="+2349035712314"
NEXT_PUBLIC_LOGO_PATH="/images/noble-farms-logo.png"

# Public marketing configuration. IDs are public identifiers, not secrets.
NEXT_PUBLIC_MARKETING_ENABLED="false"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_MARKETING_PRIMARY_REGION=""
NEXT_PUBLIC_BUSINESS_SUPPLY_ENABLED="true"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
ADMIN_EMAIL="owner@example.com"

PAYSTACK_SECRET_KEY="sk_test_your_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"

# Optional order notifications
NOTIFICATIONS_ENABLED="true"
ADMIN_NOTIFICATION_EMAIL="owner@example.com"
ADMIN_NOTIFICATION_WHATSAPP_TO="2340000000000"
FROM_EMAIL="Noble Farms <owner@example.com>"
RESEND_API_KEY="re_your_resend_api_key"

# Optional WhatsApp Business Cloud API
WHATSAPP_PROVIDER=""
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Optional generic WhatsApp webhook provider
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_SECRET=""

