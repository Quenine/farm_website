# Brand / public site configuration
NEXT_PUBLIC_SITE_NAME="Noble Farms"
NEXT_PUBLIC_SITE_URL="https://noblefarms.xyz"
NEXT_PUBLIC_SITE_DOMAIN="noblefarms.xyz"
NEXT_PUBLIC_SITE_TAGLINE="Poultry, eggs & fresh produce"
NEXT_PUBLIC_SITE_DESCRIPTION="Order eggs, broilers, fresh crop produce, tomatoes, peppers, potatoes, onions, and selected farm inputs from Noble Farms. Secure checkout, order tracking, and reliable fulfilment."
NEXT_PUBLIC_BUSINESS_ADDRESS="Noble Farms, Alapata, Ibadan, Nigeria"
NEXT_PUBLIC_BUSINESS_PHONE="+2349035712314"
NEXT_PUBLIC_BUSINESS_EMAIL="info@noblefarms.xyz"
NEXT_PUBLIC_SUPPORT_EMAIL="support@noblefarms.xyz"
NEXT_PUBLIC_ORDERS_EMAIL="orders@noblefarms.xyz"
NEXT_PUBLIC_WHATSAPP_PHONE="+2349035712314"
NEXT_PUBLIC_LOGO_PATH="/images/noble-farms-logo.png"
# For another brand, upload its logo and set NEXT_PUBLIC_LOGO_PATH, for example:
# NEXT_PUBLIC_LOGO_PATH="/images/shields-farms-logo.png"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
ADMIN_EMAIL="owner@example.com"

PAYSTACK_SECRET_KEY="sk_test_your_secret_key"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"

# Optional order notifications
NOTIFICATIONS_ENABLED=true

# Email notifications: set EMAIL_PROVIDER to gmail or resend.
EMAIL_PROVIDER=gmail
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
GMAIL_USER=
GMAIL_APP_PASSWORD=
FROM_EMAIL="Noble Farms <yourgmail@gmail.com>"
REPLY_TO_EMAIL=info@noblefarms.xyz
ADMIN_NOTIFICATION_EMAIL=

# Optional Resend email provider
RESEND_API_KEY=

# Optional WhatsApp admin recipient
ADMIN_NOTIFICATION_WHATSAPP_TO=

# Choose one WhatsApp provider: cloud, webhook, or callmebot.
WHATSAPP_PROVIDER=cloud

# WhatsApp Cloud provider
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_TEMPLATE_NAME=
WHATSAPP_CUSTOMER_STATUS_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# WhatsApp webhook provider
# To use this provider, set WHATSAPP_PROVIDER=webhook.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=

# CallMeBot testing provider
# To use this provider, set WHATSAPP_PROVIDER=callmebot.
# CallMeBot is suitable for low-volume internal testing/personal-use notifications only.
# For production WhatsApp Business messaging, use WhatsApp Cloud API.
# Customer WhatsApp status notifications require a proper WhatsApp Business provider/template or webhook provider.
# CallMeBot is for internal testing only and should not be used for customer broadcast/order updates.
CALLMEBOT_API_KEY=

